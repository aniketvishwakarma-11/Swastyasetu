{
  "name": "swastyasetu-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SwasthyaSetu - Offline-first healthcare continuity layer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build:shared && npm run build --workspace=apps/api",
    "build:web": "npm run build:shared && npm run build --workspace=apps/web && node -e \"const fs=require('fs'); try{fs.cpSync('apps/web/dist','dist',{recursive:true});}catch(e){}\"",
    "start": "npm run start --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "healthcare",
    "offline-first",
    "referral",
    "pwa",
    "digital-health"
  ],
  "author": "Team TECHX",
  "license": "MIT"
}
