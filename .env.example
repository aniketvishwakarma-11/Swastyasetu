# ----------------------------------------------------
# SwasthyaSetu / MediVault Environment Configuration
# ----------------------------------------------------

# Environment mode
NODE_ENV=development
PORT=5000
DEMO_MODE=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swastyasetu?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-token-change-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# Service URLs
API_URL="http://localhost:5000"
WEB_URL="http://localhost:5173"
AI_SERVICE_URL="http://localhost:8000"

# AI & OCR Services
OCR_PROVIDER="gemini" # options: "gemini", "trocr", "tesseract", "mock"
GEMINI_API_KEY=""

# SMS Fallback
SMS_PROVIDER="demo" # options: "demo", "twilio", "fast2sms"
SMS_API_KEY=""
SMS_FROM_NUMBER=""

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
