{
  "name": "@swastyasetu/api",
  "version": "1.0.0",
  "description": "Backend REST API and Sync Gateway for SwasthyaSetu",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/server.ts dotenv_config_path=../../.env",
    "build": "prisma generate && tsc",
    "build:web": "npm run build --workspace=apps/web && node -e \"const fs=require('fs'); fs.cpSync('../web/dist', './dist', {recursive:true});\"",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "npx prisma studio",
    "db:seed": "ts-node-dev -r dotenv/config src/seed.ts dotenv_config_path=../../.env"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@supabase/supabase-js": "^2.116.0",
    "@swastyasetu/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
