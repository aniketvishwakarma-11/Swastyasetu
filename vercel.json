{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "ai": {
      "root": "services/ai"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)?",
      "destination": {
        "type": "service",
        "service": "ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
